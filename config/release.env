#!/usr/bin/env bash

# Public release defaults. Values can be overridden in the environment before
# running bootstrap.sh or install.sh.
: "${AGENT_OS_VERSION:=0.1.0-dev}"
: "${AGENT_OS_NODE_VERSION:=24.20.0}"
: "${AGENT_OS_NODE_DIST_URL:=https://nodejs.org/download/release}"
: "${AGENT_OS_SERVER_ENTRY:=apps/gateway/dist/server.js}"
: "${AGENT_OS_HOST:=0.0.0.0}"
: "${AGENT_OS_PORT:=8787}"
: "${AGENT_OS_BOOTSTRAP_URL:=https://raw.githubusercontent.com/Jay-Huang-0130/Agent-OS/main/bootstrap.sh}"
