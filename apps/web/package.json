    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
