{
  "name": "agent-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/gateway",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspace @agent-os/web && npm run build --workspace @agent-os/gateway",
    "dev": "npm run dev --workspace @agent-os/gateway",
    "dev:web": "npm run dev --workspace @agent-os/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
